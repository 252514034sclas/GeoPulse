# ==============================================================================
# GEOPULSE PRECISION AGRICULTURE PLATFORM — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to `backend/.env` and insert your actual credentials.
# File location: C:\Users\SCAD LAB\AndroidStudioProjects\GeoPulse\backend\.env
# NEVER commit your real `.env` file to Git or public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ISRO Bhoonidhi Indian Satellite Data Portal
# ------------------------------------------------------------------------------
# Official Portal: https://bhoonidhi.nrsc.gov.in/
# API Documentation: https://bhoonidhi.nrsc.gov.in/bhoonidhi-api/
# How to get credentials:
# 1. Visit https://bhoonidhi.nrsc.gov.in/ and click "Register" / "Login".
# 2. Complete free user registration. Your user ID (email or username) and password
#    are used directly to authenticate against https://bhoonidhi-api.nrsc.gov.in/auth/token.
BHOONIDHI_USER_ID=your_bhoonidhi_user_id
BHOONIDHI_PASSWORD=your_bhoonidhi_password

# Compatibility aliases (also supported by GeoPulse):
ISRO_BHOONIDHI_USERNAME=your_bhoonidhi_user_id
ISRO_BHOONIDHI_PASSWORD=your_bhoonidhi_password


# ------------------------------------------------------------------------------
# 2. Copernicus Data Space Ecosystem (ESA Sentinel-2 Level-2A)
# ------------------------------------------------------------------------------
# Official Portal: https://dataspace.copernicus.eu/
# API Documentation: https://documentation.dataspace.copernicus.eu/
# How to get credentials:
# 1. Register for a free account at https://dataspace.copernicus.eu/
# 2. Navigate to user settings -> OAuth2 Clients.
# 3. Generate a Client ID and Client Secret for automated STAC / OData API access.
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# Compatibility aliases (also supported by GeoPulse):
COPERNICUS_CDSE_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CDSE_CLIENT_SECRET=your_copernicus_client_secret


# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# Default: Local SQLite (Zero-configuration file at `backend/geopulse.db`)
DATABASE_URL=sqlite:///./geopulse.db

# Production Enterprise: PostgreSQL + PostGIS (Recommended for high-volume GIS operations)
# DATABASE_URL=postgresql://geopulse_admin:your_secure_password@localhost:5432/geopulse_db


# ------------------------------------------------------------------------------
# 4. Weather Data Providers
# ------------------------------------------------------------------------------
# Open-Meteo High-Resolution NWP (https://open-meteo.com/):
# Open-Meteo is 100% free for standard non-commercial use up to 10,000 calls/day.
# No API key required. An optional commercial API key can be provided below if subscribed:
WEATHER_API_KEY=your_optional_open_meteo_key

# India Meteorological Department (IMD) / Mausam portal (Optional):
IMD_API_KEY=your_optional_imd_key


# ------------------------------------------------------------------------------
# 5. Indian Agricultural Mandi Market Rates (AGMARKNET & Data.gov.in)
# ------------------------------------------------------------------------------
# Official Portal: https://www.data.gov.in/ & https://agmarknet.gov.in/
# How to get API key:
# 1. Register at https://www.data.gov.in/
# 2. Generate an API Key under "My Account" -> "API Tokens" to query live wholesale arrival rates.
# Note: GeoPulse includes verified benchmark APMC rates for all Tamil Nadu & Indian mandis as fallback.
AGMARKNET_API_KEY=your_datagov_in_api_key
DATA_GOV_IN_API_KEY=your_datagov_in_api_key


# ------------------------------------------------------------------------------
# 6. Security & JWT Token Signing
# ------------------------------------------------------------------------------
SECRET_KEY=geopulse_agricultural_intelligence_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=604800
