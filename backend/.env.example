# ==============================================================================
# GeoPulse AI Precision Agriculture Platform — Environment Configuration
# ==============================================================================

# 1. Database Configuration
# Default: Local SQLite (Zero setup, file located in backend/geopulse.db)
# Production: PostgreSQL + PostGIS container or managed instance
DATABASE_URL=sqlite:///./geopulse.db
# DATABASE_URL=postgresql://geopulse_admin:your_secure_password@localhost:5432/geopulse_db

# 2. Security & JWT Authentication
SECRET_KEY=geopulse_agricultural_intelligence_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=604800

# 3. Weather Providers
# Open-Meteo: 100% Free, NO API KEY REQUIRED, up to 10,000 queries/day
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# IMD (India Meteorological Department) API (Optional / Regional fallback)
IMD_API_KEY=your_imd_api_token_here

# 4. European Space Agency (ESA) / Copernicus Sentinel Data
# Microsoft Planetary Computer STAC (Free anonymous access to Sentinel-2 Level-2A)
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PLANETARY_COMPUTER_API_KEY=optional_free_account_key
# Copernicus Data Space Ecosystem (CDSE) OAuth Credentials (https://dataspace.copernicus.eu/)
COPERNICUS_CDSE_CLIENT_ID=your_copernicus_cdse_client_id
COPERNICUS_CDSE_CLIENT_SECRET=your_copernicus_cdse_client_secret

# 5. ISRO / NRSC Bhoonidhi & Bhuvan Credentials (India)
# Official portal: https://bhoonidhi.nrsc.gov.in/ & https://bhuvan.nrsc.gov.in/
# Note: Bhoonidhi requires user registration; some datasets require manual approval.
ISRO_BHOONIDHI_USERNAME=your_bhoonidhi_registered_username
ISRO_BHOONIDHI_PASSWORD=your_bhoonidhi_password
ISRO_BHUVAN_TOKEN=your_bhuvan_token_if_registered

# 6. NASA & USGS Earth Observation (NASA POWER & Landsat)
# NASA POWER (Agroclimatology): https://power.larc.nasa.gov/ (No key required for standard queries)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_EARTHDATA_TOKEN=your_nasa_earthdata_bearer_token

# 7. Indian Agricultural Markets (Agmarknet / Data.gov.in)
# National APMC Mandi wholesale commodity rates
AGMARKNET_API_KEY=your_datagov_in_api_key

# 8. AI & Vision Services
# Google Gemini 1.5 Flash (Free tier via Google AI Studio for leaf disease & kisan chat)
GEMINI_API_KEY=your_gemini_api_key_from_aistudio_google_com
